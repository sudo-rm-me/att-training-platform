# Copy to .env.local for local development.

# --- Auth.js -------------------------------------------------------------
# Generate with: npx auth secret   (or any 32+ byte random string)
AUTH_SECRET=change-me

# Microsoft Entra ID (single-tenant app registration)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Local-only email/name login (ignored when NODE_ENV=production)
AUTH_DEV_LOGIN=true

# Comma-separated emails that are always made admins on sign-in
INITIAL_ADMIN_EMAILS=

# --- Database ------------------------------------------------------------
# Leave unset to use embedded PGlite in ./.data (no install needed).
# DATABASE_URL=postgres://att:att@localhost:5432/att
# Set to "true" to force TLS when the URL has no sslmode.
# DATABASE_SSL=false

# --- Storage (uploads: slide images, pptx imports) -----------------------
# Unset = store files on local disk under ./.data/uploads
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=media
# AZURE_CLIENT_ID=        # user-assigned managed identity client id (in Azure)

# --- Branding ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Academy
